@Library('jenkins-shared-library') _

pipeline {
    agent any
    stages {
        stage('Initialize') { steps { projectconfig() } }
        stage('Checkout')    { steps { standardCheckout() } }
        stage('Build')       { steps { dockerBuild() } }
        stage('Login')       { steps { ecrLogin() } }
        stage('Push')        { steps { dockerPush() } }
    }
}
