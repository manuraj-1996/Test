@Library('jenkins-shared-library') _

// This calls vars/projectconfig.groovy from your library
def config = projectconfig() 

pipeline {
    agent any
    environment {
        // Use double quotes and curly braces for Groovy variables
        REPO_URL         = "${config.repourl}"
        GLOBAL_GIT_CREDS = "${config.credsid}"
        APP_VERSION      = "" // Initialized here to be populated later
    }

    stages {
        stage('Checkout') {
            steps {
                // This calls vars/standardCheckout.groovy from your library
                standardCheckout() 
            }
        }

        stage('Extract Version') {
            steps {
                script {
                    // Pull version from pom.xml and update the env variable
                    env.APP_VERSION = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                    echo "Extracted Version: ${env.APP_VERSION}"
                }
            }
        }
    

        stage('Build using maven') {
            steps {
                mvnbuild()
            }
        }

        stages {
        stage('Build Docker Image') {
            steps {
                // This calls the code from your Shared Library
                dockerBuild() 
            }
        }
    }

        stages {
        stage('Login to ECR') {
            steps {
                // Just call the function from your library
                ecrLogin() 
                
                // OR override defaults if needed:
                // ecrLogin(region: 'us-west-2', credentialsId: 'prod-aws-keys')
            }
        }
    }

        stages {
        stage('Tag & Push to ECR') {
            steps {
                // This one line replaces the entire block of shell commands
                dockerPush()
            }
        }
    }
}
}
