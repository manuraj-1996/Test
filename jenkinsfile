pipeline {
    environment {
        AWS_REGION     = 'us-east-1'
        ACCOUNT_ID     = '772064137213'
        ECR_REPO       = 'devopsproject'
        // Using the global variable you set up
        ECR_URL        = "${env.GLOBAL_ECR_REGISTRY}/${ECR_REPO}"
        IMAGE_NAME     = 'studentapp'
        REPO_URL       = 'https://github.com/manuraj-1996/Test.git'
        APP_VERSION    = "" 
    }

    agent any

    stages {
        stage('Checkout & Get Version') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: "${env.REPO_URL}",
                        credentialsId: "${env.GLOBAL_GIT_CREDS}"
                    ]]
                ])
                
                script {
                    // Pull version from pom.xml and update the environment variable
                    APP_VERSION = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                    echo "Extracted Version: ${APP_VERSION}"
                }
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean install -DskipTests' // Added skipTests for speed, remove if needed
            }
        }

        stage('Build Docker Image') {
            steps {
                // Build the local image using the extracted version
                sh "docker build -t ${IMAGE_NAME}:${APP_VERSION} ."
            }
        }

        stage('Login to ECR') {
            steps {
                // withAWS is cleaner if you have the Pipeline AWS Steps plugin
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-cred']]) {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                }
            }
        }

        stage('Tag & Push to ECR') {
            steps {
                sh """
                    # 1. Tag local image to the ECR format
                    docker tag ${IMAGE_NAME}:${APP_VERSION} ${ECR_URL}:${APP_VERSION}
                    
                    
                    # 2. Push both tags
                    docker push ${ECR_URL}:${APP_VERSION}
                    
                """
            }
        }
    }
}
